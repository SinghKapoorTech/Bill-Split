rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles. These documents hold PII (email, phoneNumber, venmoId) and
    // the friend graph, so the collection must never be enumerable.
    match /users/{userId} {
      // READS are split get/list on purpose.
      //   get  — settlements, events, squads and friend hydration all resolve
      //          other people's profiles by id, so single-doc reads stay open.
      //   list — every legitimate query here is bounded (username search,
      //          contact lookup, documentId() batches of <= 30), so a page-size
      //          cap costs nothing and blocks the one-shot
      //          `getDocs(collection(db,'users'))` dump.
      //
      // HONEST LIMITATION: this caps page size, not enumeration. Rules cannot
      // see cursors, so a determined caller can still page the collection with
      // orderBy + startAfter, ~30 docs per request. Closing that properly means
      // moving email/phoneNumber into a private subcollection and putting search
      // behind a callable; tracked as follow-up, not solved here.
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 30;

      // WRITES are your own document only.
      // Shadow users are stand-ins for people who have not signed up yet; their
      // creator may manage them, and only their creator. createdById is pinned
      // on update so a shadow cannot be re-attributed to another user.
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.isShadow == true &&
         request.resource.data.createdById == request.auth.uid)
      );
      // NOTE: `.get('createdById', null)` is deliberate. Legacy shadow users
      // predate this field, and a bare `resource.data.createdById` on a document
      // that lacks it raises an EVALUATION ERROR, which hard-denies the write
      // for everyone — including the rightful creator — with no client-side
      // repair possible. Those documents need the backfill in
      // scripts/backfill-shadow-creators.mjs before this rule is deployed.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.isShadow == true &&
         resource.data.get('createdById', null) == request.auth.uid &&
         request.resource.data.isShadow == true &&
         request.resource.data.get('createdById', null) == resource.data.get('createdById', null))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }



    // Events collection - users can read events they own or are members of
    match /events/{eventId} {
      // An update that turns `archived` off — by setting it false OR by removing
      // the field, since `isEventArchived()` treats a missing field as ACTIVE.
      //
      // Unarchiving is gated by the free-tier group cap, and a cap needs a
      // COUNT of the owner's active events, which rules cannot compute. So the
      // check lives in the `unarchiveEvent` callable and this rule exists to
      // make that callable the only way in — otherwise the cap is bypassable in
      // three taps: archive A, create C, unarchive A.
      //
      // `get('archived', false)` rather than a bare read: after a deleteField()
      // the key is absent from request.resource.data, and reading a missing
      // field is an ERROR in rules (an erroring rule denies, which would be
      // right here by accident but wrong everywhere else).
      function isUnarchiving() {
        return 'archived' in request.resource.data.diff(resource.data).affectedKeys() &&
               request.resource.data.get('archived', false) != true;
      }

      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.ownerId ||
                      request.auth.uid in resource.data.memberIds ||
                      request.auth.token.email in resource.data.pendingInvites);

      // CREATE IS SERVER-ONLY. Event creation counts against the free-tier
      // owned-active-group cap, which requires an aggregation query that rules
      // cannot run — so it goes through the `createEvent` callable (Admin SDK),
      // exactly as bill creation goes through `createBill`.
      //
      // DEPLOYMENT — DELIBERATE BREAKING CHANGE, owner-confirmed 2026-09-06.
      // Any already-installed App Store / Play build calls addDoc() directly and
      // will get permission-denied FOREVER once this deploys. No deploy ordering
      // fixes that: the binary is on the device. A minimum-version gate now
      // exists (shared/versionGate.ts) so the NEXT such change can show an
      // update wall instead of failing — but it only helps builds that already
      // contain it, which is exactly why it had to ship in 1.0.
      //
      // Chosen as a hard cutover because the installed base only ever grows —
      // this breakage is at its cheapest today, pre-launch, with the database
      // due to be wiped (spec §6.5). Ship the functions with or before these
      // rules, and treat older builds as unable to create events.
      allow create: if false;

      allow update: if request.auth != null &&
                       ((request.auth.uid == resource.data.ownerId && !isUnarchiving()) ||
                        // Allow members to update memberIds and pendingInvites (for auto-accept)
                        (request.auth.uid in resource.data.memberIds &&
                         onlyUpdating(['memberIds', 'pendingInvites', 'updatedAt'])) ||
                        // Allow invited users to accept their own invitation
                        (request.auth.token.email in resource.data.pendingInvites &&
                         onlyUpdating(['memberIds', 'pendingInvites', 'updatedAt'])));
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========== Squads Collection ==========
    match /squads/{squadId} {
      // Reads are scoped to members, so the collection is not enumerable and a
      // squad id alone reveals nothing.
      // `resource == null` is load-bearing: a get() on a document that does not
      // exist (deleted squad, stale link, SquadDetailView's URL param) has no
      // `resource`, and dereferencing resource.data there raises an EVALUATION
      // ERROR that hard-denies instead of returning "not found". Without it the
      // app surfaces permission-denied for an ordinary missing squad.
      allow get: if request.auth != null &&
                    (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // WRITES ARE SERVER-ONLY. A squad document names its own members, and
      // membership is mirrored onto users/{uid}.squadIds — which grants access
      // to bills carrying that squadId. A client able to write memberIds could
      // therefore force a stranger into a squad it controls and read their
      // bills. Both documents are written together, in one Admin batch, by
      // createSquad / updateSquad / deleteSquad in functions/src/squadFunctions.ts.
      allow write: if false;
    }

    // Helper function to check if only specific fields are being updated
    function onlyUpdating(allowedFields) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(allowedFields);
    }

    // ========== Bills Collection Helper Functions ==========
    
    // Check if current user is in the bill's members array
    function isBillMember(billData) {
      return request.auth != null &&
             billData.members != null &&
             billData.members.hasAny([{'userId': request.auth.uid}]);
    }
    
    // Validate that only allowed fields are being updated (for guests)
    function isGuestUpdate() {
      let allowedFields = ['itemAssignments', 'people', 'lastActivity', 'updatedAt', 'members', 'splitEvenly', 'currentStep'];
      return onlyUpdating(allowedFields);
    }

    // ========== Bills Collection Security Rules ==========
    
    match /bills/{billId} {
      // Helper: Check if bill has a valid (non-expired) share code
      function hasValidShareCode() {
        return 'shareCode' in resource.data && resource.data.shareCode != null && 
               'shareCodeExpiresAt' in resource.data && resource.data.shareCodeExpiresAt != null &&
               resource.data.shareCodeExpiresAt > request.time;
      }

      function hasEventIdAndMember(data) {
        // Safe check for eventId existence and mapping
        let eId = 'eventId' in data ? data.eventId : ('eventId' in resource.data ? resource.data.eventId : null);
        let eventExists = exists(/databases/$(database)/documents/events/$(eId));
        return eId != null && eventExists && (
          request.auth.uid == get(/databases/$(database)/documents/events/$(eId)).data.ownerId ||
          ('memberIds' in get(/databases/$(database)/documents/events/$(eId)).data && 
           request.auth.uid in get(/databases/$(database)/documents/events/$(eId)).data.memberIds)
        );
      }

      // Helper: the event this bill is being filed into is NOT archived.
      //
      // The rules half of the archive soft-lock (spec §4.2.1). `createBillCore`
      // enforces the same thing server-side, but `allow create` below is open to
      // any event member, so without this a client could `addDoc` straight past
      // the callable. Archiving is what frees a slot against the free-tier group
      // cap, so an archive that still accepts bills makes the cap decorative.
      //
      // ABSENCE IS ACTIVE, and the `in` guard is load-bearing: reading a field
      // that does not exist is an ERROR in rules, and a rule that errors DENIES.
      // Every event written before the archive feature has no `archived` field,
      // so dropping that guard would block new bills in every historical event.
      //
      // Only a literal `true` archives — mirroring `isEventArchived()` in
      // shared/eventArchive.ts, which is the single arbiter for client and
      // server. A non-boolean truthy value from a bad write must not silently
      // lock an event its owner never closed.
      //
      // A missing event is deliberately NOT this function's problem:
      // hasEventIdAndMember() already denies that case.
      function eventNotArchived(data) {
        let eId = 'eventId' in data ? data.eventId : null;
        return eId == null ||
               !exists(/databases/$(database)/documents/events/$(eId)) ||
               !('archived' in get(/databases/$(database)/documents/events/$(eId)).data) ||
               get(/databases/$(database)/documents/events/$(eId)).data.archived != true;
      }

      // Helper: this update REPOINTS `eventId`, and the new target is archived.
      //
      // Gating `create` alone left the archive lock decorative against exactly
      // the client it was written for: `allow update` gives the owner and event
      // members full field access, so two writes reach an archived event —
      // create the bill somewhere legal, then move it. It would then appear in
      // the archived event and drive its `event_balances` pair docs.
      //
      // KEYED ON `eventId` CHANGING, never on the bill merely being in an
      // archived event. Settling writes `settledPersonIds`/`updatedAt`/
      // `lastActivity` on bills that already sit in archived events, and that
      // must keep working — a person must never be blocked from paying someone
      // back (spec §4.2.1). An update that does not touch `eventId` is not this
      // function's business.
      function isMovingIntoArchivedEvent() {
        return 'eventId' in request.resource.data.diff(resource.data).affectedKeys() &&
               !eventNotArchived(request.resource.data);
      }

      // Helper: this update REPOINTS `eventId` at an event the caller has no part in.
      //
      // PRE-EXISTING HOLE, closed here. `allow update` grants the bill owner
      // unrestricted field access and never validated the NEW `eventId`, so the
      // owner of any bill could file it — and the debt it creates — into a
      // stranger's group. `hasEventIdAndMember()` already guarded this on
      // CREATE; the update path simply never called it.
      //
      // Ordering is load-bearing and relies on short-circuit evaluation:
      //   1. `eventId` actually changing — cheap, needs no auth, and false for
      //      the overwhelming majority of updates (settling, claiming items),
      //      so those cost ZERO extra document reads.
      //   2. the new value is non-null — DETACHING a bill (`eventId: null`, or
      //      deleting the field) is always allowed: it removes a bill from a
      //      group, it does not push one in.
      //   3. only then the membership `get()`.
      //
      // A non-existent target is also refused, because hasEventIdAndMember()
      // requires the event to exist.
      function isMovingIntoForeignEvent() {
        return 'eventId' in request.resource.data.diff(resource.data).affectedKeys() &&
               request.resource.data.get('eventId', null) != null &&
               !hasEventIdAndMember(request.resource.data);
      }

      // Helper: Check if user is a member of the squad attached to this bill
      function hasSquadIdAndMember(data) {
        let sId = 'squadId' in data ? data.squadId : null;
        return sId != null && 
          exists(/databases/$(database)/documents/squads/$(sId)) &&
          request.auth.uid in get(/databases/$(database)/documents/squads/$(sId)).data.memberIds;
      }


      // Helper: Only settlement-related fields are being changed.
      // processedBalances is written exclusively by the server-side pipeline.
      function isSettlementUpdate() {
        return onlyUpdating(['settledPersonIds', 'updatedAt', 'lastActivity']);
      }

      // READ:
      // - Authenticated: Owner, event members, squad members, linked participants, or bill members
      // - Anonymous: Bills with valid share code (for join flow)
      // NOTE: Draft visibility for non-owners is enforced client-side only (not in rules).
      // Adding a status constraint here would break query-rule alignment: the useBills query
      // filters by participantIds only, and Firestore rejects any query that could return
      // documents the rules would deny. Client-side filter handles draft hiding safely.
      allow read: if
        // Anonymous users can read bills with valid share codes
        hasValidShareCode() ||
        // Authenticated users follow normal rules
        (request.auth != null && (
          // Owner can always read
          request.auth.uid == resource.data.ownerId ||
          // Linked participant via participantIds (null-safe for pre-migration bills)
          ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds) ||
          // Event members can read event bills
          hasEventIdAndMember(resource.data) ||
          // Squad members can read squad bills
          hasSquadIdAndMember(resource.data) ||
          // Legacy: authenticated members can read (includes guests who joined via share link)
          isBillMember(resource.data)
        ));
      
      // CREATE: Authenticated users only, must set themselves as owner
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       // For event bills, user must be a member of the event
                       (!('eventId' in request.resource.data) || 
                        request.resource.data.eventId == null ||
                        hasEventIdAndMember(request.resource.data)) &&
                       // ...and the event must not be archived. CREATION ONLY —
                       // updates (settling up, editing an existing bill) are
                       // deliberately untouched: a person must never be blocked
                       // from paying someone back.
                       eventNotArchived(request.resource.data);
      
      // UPDATE:
      // - Owner and event members have full access
      // - Authenticated members can update limited fields
      // - Anonymous users with valid share code can update limited fields (for claiming items)
      // - Linked participants can update settlement fields only (bidirectional settle-up)
      allow update: if
        // Two rules about the DESTINATION of a move, applied to every branch
        // below rather than to one, so a future branch cannot reopen either:
        // no bill may be moved into an archived event, and none into an event
        // the caller does not belong to. Both are no-ops unless `eventId`
        // actually changes, so ordinary updates (settling, editing) are
        // untouched and pay no extra reads.
        !isMovingIntoArchivedEvent() && !isMovingIntoForeignEvent() && (
        // Anonymous users with valid share code can update assignments/people
        (hasValidShareCode() && isGuestUpdate()) ||
        // Authenticated users follow normal rules
        (request.auth != null && (
          // Owner has full access
          request.auth.uid == resource.data.ownerId ||
          // Event members have full access to event bills
          hasEventIdAndMember(resource.data) ||
          // Squad members have full access to squad bills
          hasSquadIdAndMember(resource.data) ||
          // Legacy: authenticated members can update specific fields
          (isBillMember(resource.data) && isGuestUpdate()) ||
          // Linked participant can perform guest updates (claim items, touch bill) or mark settlement
          ('participantIds' in resource.data &&
           request.auth.uid in resource.data.participantIds &&
           (isGuestUpdate() || isSettlementUpdate()))
        )));
      
      // DELETE: Only owner can delete
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========== Entitlements & Usage (Admin SDK only) ==========
    // Plan state and consumption counters. Written EXCLUSIVELY by the Admin SDK
    // (the RevenueCat webhook and analyzeBill). A client that could write these
    // could grant itself Pro or reset its own scan quota, so ALL client writes
    // are denied — including the owner's own.
    //
    // Reads are owner-only so the app can render the quota indicator and paywall
    // state. Client reads are a RENDERING HINT ONLY; every limit is enforced
    // server-side. See docs/superpowers/specs/2026-09-06-monetization-design.md
    // §5.1 and §4.3.1.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ========== Friend Balances Collection ==========
    match /balances/{balanceId} {
      // allow get: handles both existing docs and non-existent docs.
      // resource == null is required so that runTransaction's transaction.get()
      // on a brand-new (not-yet-created) document doesn't throw a null-ref error.
      allow get: if request.auth != null &&
                    (resource == null || request.auth.uid in resource.data.participants);

      // allow list: handles getDocs() queries.
      // For queries, resource is never null, so we just check participants directly.
      // Firestore can verify this is safe because the query always filters by the
      // same uid: where('participants', 'array-contains', request.auth.uid).
      allow list: if request.auth != null &&
                     request.auth.uid in resource.data.participants;

      // Admin-only: server-side ledgerProcessor pipeline writes via Admin SDK
      allow create: if false;
      allow update: if false;

      allow delete: if false;
    }

    // ========== Event Balances Collection (per-pair, mirrors balances) ==========
    match /event_balances/{balanceId} {
      // allow get: handles both existing docs and non-existent docs (transaction reads)
      allow get: if request.auth != null &&
                    (resource == null || request.auth.uid in resource.data.participants);

      // allow list: for queries filtering by eventId
      // We allow reading if the user is a member of the event
      allow list: if request.auth != null &&
                     (
                       request.auth.uid in resource.data.participants ||
                       ('eventId' in resource.data && resource.data.eventId != null &&
                        exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
                        (request.auth.uid == get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId ||
                         ('memberIds' in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data &&
                          request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.memberIds)))
                     );

      // Admin-only: server-side ledgerProcessor pipeline writes via Admin SDK
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ========== Settlements Collection ==========
    match /settlements/{settlementId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.fromUserId ||
                      request.auth.uid == resource.data.toUserId ||
                      ('eventId' in resource.data && resource.data.eventId != null &&
                       exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
                       (request.auth.uid == get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId ||
                        ('memberIds' in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data &&
                         request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.memberIds))));
      
      allow create: if request.auth != null &&
                       (request.auth.uid == request.resource.data.fromUserId ||
                        request.auth.uid == request.resource.data.toUserId);
                        
      allow update: if false; // Settlements should be immutable
      
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.fromUserId ||
                        request.auth.uid == resource.data.toUserId);
    }

    // ========== Settlement Requests Collection ==========
    match /settlement_requests/{requestId} {
      // Get: allow for non-existent docs (needed for check-before-create pattern)
      allow get: if request.auth != null &&
                    (resource == null ||
                     request.auth.uid == resource.data.fromUserId ||
                     request.auth.uid == resource.data.toUserId);

      // List: only participants can query
      allow list: if request.auth != null &&
                     (request.auth.uid == resource.data.fromUserId ||
                      request.auth.uid == resource.data.toUserId);

      // Create: only the debtor (fromUserId), must be pending, amount > 0, not self-request
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.fromUserId &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.fromUserId != request.resource.data.toUserId &&
                       request.resource.data.createdAt == request.time &&
                       !('resolvedAt' in request.resource.data);

      // Update: only the creditor (toUserId), can only change status + resolvedAt
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.toUserId &&
                       resource.data.status == 'pending' &&
                       (request.resource.data.status == 'approved' ||
                        request.resource.data.status == 'declined') &&
                       request.resource.data.resolvedAt == request.time &&
                       onlyUpdating(['status', 'resolvedAt']);

      // Delete: either participant (for cleanup)
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.fromUserId ||
                        request.auth.uid == resource.data.toUserId);
    }

    // ========== Recurring Bills Collection ==========
    match /recurring_bills/{recurringBillId} {
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.ownerId;
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.ownerId;
    }

    // Receipt analysis cache (locked down — re-enable when feature is re-added)
    match /receiptAnalysisCache/{document=**} {
      allow read, write: if false;
    }

    // Event invitations - users can read their own invitations
    match /eventInvitations/{invitationId} {
      allow read: if request.auth != null &&
                     (request.auth.token.email == resource.data.email ||
                      request.auth.uid == resource.data.invitedBy);
      allow write: if request.auth != null &&
                      request.auth.uid == resource.data.invitedBy;
      allow update: if request.auth != null &&
                       request.auth.token.email == resource.data.email;
    }

    // ========== Feedback Collection ==========
    match /feedback/{feedbackId} {
      // Create: authenticated users only, must set own userId
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      // No client reads/updates/deletes — admin console only
      allow read, update, delete: if false;
    }
  }
}
